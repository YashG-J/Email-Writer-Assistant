# Copy to application.properties (git-ignored) and fill in values.
# Gemini endpoint WITHOUT the ?key= query parameter; the key is sent as a header.
gemini.api.url=${GEMINI_URL:https://generativelanguage.googleapis.com/v1/models/gemini-pro:generateContent}
gemini.api.key=${GEMINI_KEY:}

# Comma-separated list of origins allowed to call /api/**
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173,https://mail.google.com}
